# 复制本文件为 .env 后填写真实值。.env 已被 .gitignore 排除，不要提交。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
# 至少 32 字节的随机串，生成方法：openssl rand -base64 48
JWT_SECRET=
# Python 侧调用内部接口时携带的令牌，用 openssl rand -base64 32 生成
INTERNAL_TOKEN=
AGENT_BASE_URL=http://127.0.0.1:8001

