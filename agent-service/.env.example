# ============ 应用配置 ============
APP_NAME=安心保
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# ============ 日志 ============
LOGGING_LEVEL=DEBUG

# ============ PostgreSQL ============
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=请替换为你的数据库密码

# ============ 大模型 ============
DEEPSEEK_API_KEY=sk-请替换为你的Key
CHAT_MODEL=deepseek-v4-flash

# 阿里云百炼（向量化 + 重排）
DASHSCOPE_API_KEY=sk-请替换为你的Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 文档解析 MinerU ============
MINERU_TOKEN=请替换为你的Token

# ============ Milvus ============
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ============ 服务间调用 ============
# 必须与 insurance-biz/.env 的 INTERNAL_TOKEN 完全一致，
# 用 openssl rand -base64 32 生成一次，两边各填一份
INTERNAL_TOKEN=请替换为与 Java 侧一致的令牌

# Java 业务服务地址：Python 需要产品数据时回调它
JAVA_BASE_URL=http://127.0.0.1:8080
